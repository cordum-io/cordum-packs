# Cordum Temporal Pack — Environment Variables

CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Temporal Connection ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
CORDUM_TEMPORAL_IDENTITY=cordum-temporal-worker

# --- Temporal Cloud (optional) ---
TEMPORAL_API_KEY=

# --- TLS (optional) ---
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=
TEMPORAL_TLS_CA=

# --- Worker ---
CORDUM_TEMPORAL_POOL=temporal
CORDUM_TEMPORAL_SUBJECTS=job.temporal.*
CORDUM_TEMPORAL_MAX_PARALLEL=0
CORDUM_TEMPORAL_REQUEST_TIMEOUT=30s

# --- Restrictions ---
CORDUM_TEMPORAL_ALLOWED_TASK_QUEUES=
CORDUM_TEMPORAL_DENIED_TASK_QUEUES=
CORDUM_TEMPORAL_ALLOWED_WORKFLOWS=
CORDUM_TEMPORAL_DENIED_WORKFLOWS=
