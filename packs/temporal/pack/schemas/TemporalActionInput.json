{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Temporal Action Input",
  "type": "object",
  "properties": {
    "profile": { "type": "string" },
    "action": {
      "type": "string",
      "enum": [
        "workflow.start", "workflow.signal", "workflow.query",
        "workflow.describe", "workflow.cancel", "workflow.terminate",
        "workflow.list",
        "schedule.create", "schedule.list", "schedule.describe",
        "schedule.delete", "schedule.pause", "schedule.unpause"
      ]
    },
    "params": { "type": "object" },
    "request_id": { "type": "string" }
  },
  "required": ["action"]
}
