# Cordum Azure Pack — Environment Variables

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker Configuration ---
CORDUM_AZURE_POOL=azure
CORDUM_AZURE_QUEUE=azure
CORDUM_AZURE_SUBJECTS=job.azure.*
CORDUM_AZURE_MAX_PARALLEL=0
CORDUM_AZURE_REQUEST_TIMEOUT=60s
CORDUM_AZURE_RESULT_TTL=0s

# --- Azure Credentials (DefaultAzureCredential chain) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
CORDUM_AZURE_RESOURCE_GROUP=

# --- Action Restrictions (optional, comma-separated globs) ---
CORDUM_AZURE_ALLOW_ACTIONS=
CORDUM_AZURE_DENY_ACTIONS=

# --- Multi-Profile (optional, JSON array) ---
# CORDUM_AZURE_PROFILES=[{"name":"prod","tenant_id":"...","client_id":"...","client_secret_env":"PROD_AZURE_SECRET","subscription_id":"...","allow_actions":["blob.*","keyvault.*"]}]
