{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Azure Action Input",
  "description": "Generic action dispatcher for the Azure pack.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "description": "Named integration profile to use."
    },
    "action": {
      "type": "string",
      "description": "Action identifier.",
      "enum": [
        "functions.invoke",
        "functions.list_apps",
        "blob.get",
        "blob.upload",
        "blob.list",
        "blob.list_containers",
        "blob.delete",
        "servicebus.send",
        "servicebus.peek",
        "servicebus.list_queues",
        "compute.list_vms",
        "compute.get_vm",
        "compute.get_vm_instance_view",
        "monitor.query_metrics",
        "monitor.list_alert_rules",
        "keyvault.get_secret",
        "keyvault.list_secrets",
        "entra.get_user",
        "entra.list_users",
        "entra.list_groups"
      ]
    },
    "subscription_id": {
      "type": "string",
      "description": "Azure subscription ID override."
    },
    "resource_group": {
      "type": "string",
      "description": "Azure resource group override."
    },
    "params": {
      "type": "object",
      "description": "Action-specific parameters."
    },
    "request_id": {
      "type": "string",
      "description": "Optional idempotency or trace id."
    }
  },
  "required": ["action"]
}
