{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Azure Key Vault Get Secret Input",
  "description": "Input schema for Azure Key Vault secret retrieval.",
  "type": "object",
  "properties": {
    "vault_name": {
      "type": "string",
      "description": "Key Vault name."
    },
    "secret_name": {
      "type": "string",
      "description": "Secret name."
    },
    "version": {
      "type": "string",
      "description": "Secret version (empty for latest)."
    }
  },
  "required": ["vault_name", "secret_name"]
}
