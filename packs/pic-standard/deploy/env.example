# --- Common Cordum settings ---
CORDUM_GATEWAY_URL=http://localhost:8081
# Leave blank for local/dev (no auth required against local gateway)
CORDUM_API_KEY=
CORDUM_TENANT_ID=default

# CAP SDK defaults (also accepted: CORDUM_NATS_URL / CORDUM_REDIS_URL)
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
# Optional aliases (also supported)
# CORDUM_NATS_URL=nats://localhost:4222
# CORDUM_REDIS_URL=redis://localhost:6379

# --- PIC Standard pack settings ---
CORDUM_PIC_STANDARD_POOL=pic-standard-primary
CORDUM_PIC_STANDARD_QUEUE=pic-standard
CORDUM_PIC_STANDARD_SUBJECTS=job.pic-standard.verify
CORDUM_PIC_STANDARD_MAX_PARALLEL=8
CORDUM_PIC_STANDARD_REQUEST_TIMEOUT=15s

# How long Cordum job results are kept in Redis (0s = no TTL)
CORDUM_PIC_STANDARD_RESULT_TTL=0s

# --- PIC bridge settings ---
CORDUM_PIC_STANDARD_BRIDGE_URL=http://localhost:3100
CORDUM_PIC_STANDARD_BRIDGE_TIMEOUT=5s
CORDUM_PIC_STANDARD_LOG_LEVEL=info

# Comma-separated impact types that require human approval
# Example: CORDUM_PIC_STANDARD_REQUIRE_APPROVAL_IMPACTS=money,privacy,irreversible
CORDUM_PIC_STANDARD_REQUIRE_APPROVAL_IMPACTS=
