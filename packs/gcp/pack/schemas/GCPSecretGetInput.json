{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GCP Secret Manager Get Secret Input",
  "description": "Input schema for accessing a Secret Manager secret version.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "description": "Named integration profile to use."
    },
    "project_id": {
      "type": "string",
      "description": "GCP project override. Falls back to profile/config default."
    },
    "location": {
      "type": "string",
      "description": "GCP region/location override (for example us-central1)."
    },
    "request_id": {
      "type": "string",
      "description": "Optional idempotency or trace identifier."
    },
    "secret_id": {
      "type": "string",
      "description": "Secret ID or fully-qualified secret resource name."
    },
    "version": {
      "type": "string",
      "description": "Secret version to access.",
      "default": "latest"
    }
  },
  "required": [
    "secret_id"
  ],
  "additionalProperties": false
}
