{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GCP Storage Upload Object Input",
  "description": "Input schema for uploading an object to Cloud Storage.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "description": "Named integration profile to use."
    },
    "project_id": {
      "type": "string",
      "description": "GCP project override. Falls back to profile/config default."
    },
    "location": {
      "type": "string",
      "description": "GCP region/location override (for example us-central1)."
    },
    "request_id": {
      "type": "string",
      "description": "Optional idempotency or trace identifier."
    },
    "bucket": {
      "type": "string",
      "description": "Cloud Storage bucket name."
    },
    "object_name": {
      "type": "string",
      "description": "Object name/path."
    },
    "data": {
      "type": "string",
      "description": "Object body as a plain string or base64-encoded payload."
    },
    "content_type": {
      "type": "string",
      "description": "MIME content type.",
      "default": "application/octet-stream"
    },
    "content_encoding": {
      "type": "string",
      "description": "Optional content encoding, for example base64."
    }
  },
  "required": [
    "bucket",
    "object_name",
    "data"
  ],
  "additionalProperties": false
}
