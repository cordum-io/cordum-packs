# Cordum GCP Pack — Environment Variables

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker Configuration ---
CORDUM_GCP_POOL=gcp
CORDUM_GCP_QUEUE=gcp
CORDUM_GCP_SUBJECTS=job.gcp.*
CORDUM_GCP_MAX_PARALLEL=0
CORDUM_GCP_REQUEST_TIMEOUT=60s
CORDUM_GCP_RESULT_TTL=0s
CORDUM_GCP_USER_AGENT=cordum-gcp-worker/0.1.0

# --- Default GCP Target ---
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
CORDUM_GCP_DEFAULT_LOCATION=global

# --- Authentication ---
# Application Default Credentials are used automatically when no explicit
# credentials file is configured.
GOOGLE_APPLICATION_CREDENTIALS=
CORDUM_GCP_IMPERSONATE_SERVICE_ACCOUNT=

# --- Action / Project Restrictions (optional, comma-separated globs) ---
CORDUM_GCP_ALLOW_ACTIONS=
CORDUM_GCP_DENY_ACTIONS=
CORDUM_GCP_ALLOWED_PROJECTS=
CORDUM_GCP_DENIED_PROJECTS=

# --- Profile Selection ---
CORDUM_GCP_DEFAULT_PROFILE=default

# --- Multi-Profile (optional, JSON array) ---
# CORDUM_GCP_PROFILES=[{"name":"prod","project_id":"prod-project","location":"us-central1","credentials_file_env":"PROD_GOOGLE_APPLICATION_CREDENTIALS","impersonate_sa":"cordum-prod@prod-project.iam.gserviceaccount.com","allow_actions":["storage.*","pubsub.*"],"allowed_projects":["prod-project"]},{"name":"staging","project_id":"staging-project","location":"us-east1","allow_actions":["functions.*","compute.*"]}]
