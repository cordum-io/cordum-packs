{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hugging Face Action Input",
  "type": "object",
  "properties": {
    "profile": { "type": "string" },
    "action": {
      "type": "string",
      "enum": ["inference", "embed", "models.search", "models.get", "spaces.get", "spaces.restart"]
    },
    "params": { "type": "object" },
    "request_id": { "type": "string" }
  },
  "required": ["action"]
}
