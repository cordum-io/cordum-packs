{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hugging Face Action Result",
  "type": "object",
  "properties": {
    "job_id": { "type": "string" },
    "profile": { "type": "string" },
    "action": { "type": "string" },
    "status_code": { "type": "integer" },
    "request_id": { "type": "string" },
    "duration_ms": { "type": "number" },
    "model_id": { "type": "string" },
    "task": { "type": "string" },
    "result": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "embeddings": { "type": "array" },
    "error": { "type": "string" },
    "estimated_time": { "type": "number", "description": "Seconds until model is loaded (503 response)." }
  }
}
