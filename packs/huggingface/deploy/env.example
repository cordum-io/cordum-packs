# Cordum Hugging Face Pack — Environment Variables

CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Hugging Face ---
HF_TOKEN=

# --- Worker ---
CORDUM_HUGGINGFACE_POOL=huggingface
CORDUM_HUGGINGFACE_SUBJECTS=job.huggingface.*
CORDUM_HUGGINGFACE_MAX_PARALLEL=0
CORDUM_HUGGINGFACE_REQUEST_TIMEOUT=120s
CORDUM_HUGGINGFACE_RESULT_TTL=0s

# --- API URLs ---
CORDUM_HUGGINGFACE_INFERENCE_URL=https://api-inference.huggingface.co
CORDUM_HUGGINGFACE_HUB_URL=https://huggingface.co/api

# --- Task Restrictions ---
CORDUM_HUGGINGFACE_ALLOWED_TASKS=
CORDUM_HUGGINGFACE_DENIED_TASKS=
