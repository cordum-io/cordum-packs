CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

CORDUM_OPENAI_POOL=openai
CORDUM_OPENAI_QUEUE=openai
CORDUM_OPENAI_SUBJECTS=job.openai.*
CORDUM_OPENAI_MAX_PARALLEL=0
CORDUM_OPENAI_REQUEST_TIMEOUT=90s
CORDUM_OPENAI_RESULT_TTL=0s
CORDUM_OPENAI_ALLOW_INLINE_AUTH=false
CORDUM_OPENAI_ALLOW_INLINE_SECRETS=false
CORDUM_OPENAI_DEFAULT_PROFILE=default

CORDUM_OPENAI_BASE_URL=https://api.openai.com/v1
CORDUM_OPENAI_API_KEY=
CORDUM_OPENAI_API_KEY_ENV=OPENAI_API_KEY
CORDUM_OPENAI_ORGANIZATION=
CORDUM_OPENAI_ORGANIZATION_ENV=
CORDUM_OPENAI_ALLOWED_MODELS=
CORDUM_OPENAI_DENIED_MODELS=
CORDUM_OPENAI_MAX_TOKENS_LIMIT=0
CORDUM_OPENAI_COST_TRACKING=true
CORDUM_OPENAI_RATE_LIMIT_RETRY=true
CORDUM_OPENAI_MAX_RETRIES=2

