{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAI Chat Completion Input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": { "type": "string" },
    "model": {
      "type": "string",
      "enum": ["gpt-4o", "gpt-4-turbo", "gpt-3.5-turbo"]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant", "tool", "function", "developer"]
          },
          "content": {
            "oneOf": [
              { "type": "string" },
              { "type": "array" },
              { "type": "object" }
            ]
          },
          "name": { "type": "string" },
          "tool_call_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "max_tokens": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "tools": { "type": "array" },
    "tool_choice": {
      "oneOf": [
        { "type": "string", "enum": ["none", "auto", "required"] },
        { "type": "object" }
      ]
    },
    "response_format": { "type": "object" },
    "stream": { "type": "boolean" },
    "auth": {
      "type": "object",
      "properties": {
        "api_key": { "type": "string" },
        "api_key_env": { "type": "string" },
        "organization": { "type": "string" },
        "organization_env": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["model", "messages"]
}
