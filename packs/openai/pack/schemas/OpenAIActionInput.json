{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAI Action Input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": { "type": "string" },
    "action": {
      "type": "string",
      "enum": [
        "chat.completions",
        "chat.completions.stream",
        "embeddings",
        "images.generate",
        "audio.transcriptions",
        "audio.speech",
        "fine_tuning.jobs.create",
        "fine_tuning.jobs.list",
        "fine_tuning.jobs.get",
        "fine_tuning.jobs.cancel",
        "models.list"
      ]
    },
    "model": { "type": "string" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant", "tool", "function", "developer"]
          },
          "content": {
            "oneOf": [
              { "type": "string" },
              { "type": "array" },
              { "type": "object" }
            ]
          },
          "name": { "type": "string" },
          "tool_call_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "max_tokens": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "tools": { "type": "array" },
    "tool_choice": {
      "oneOf": [
        { "type": "string" },
        { "type": "object" }
      ]
    },
    "response_format": { "type": "object" },
    "stream": { "type": "boolean" },
    "input": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "dimensions": { "type": "integer", "minimum": 1, "maximum": 3072 },
    "encoding_format": { "type": "string", "enum": ["float", "base64"] },
    "prompt": { "type": "string", "minLength": 1 },
    "size": {
      "type": "string",
      "enum": ["256x256", "512x512", "1024x1024", "1024x1792", "1792x1024"]
    },
    "quality": { "type": "string", "enum": ["standard", "hd"] },
    "style": { "type": "string", "enum": ["vivid", "natural"] },
    "n": { "type": "integer", "minimum": 1, "maximum": 10 },
    "file_url": { "type": "string", "format": "uri" },
    "language": { "type": "string", "minLength": 2, "maxLength": 16 },
    "voice": {
      "type": "string",
      "enum": ["alloy", "ash", "ballad", "cedar", "coral", "echo", "fable", "marin", "nova", "onyx", "sage", "shimmer"]
    },
    "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
    "format": { "type": "string", "enum": ["mp3", "opus", "aac", "flac", "wav", "pcm"] },
    "fine_tune_id": { "type": "string" },
    "training_file": { "type": "string" },
    "validation_file": { "type": "string" },
    "suffix": { "type": "string", "maxLength": 64 },
    "hyperparameters": {
      "type": "object",
      "properties": {
        "n_epochs": { "type": ["integer", "string"], "minimum": 1 },
        "batch_size": { "type": ["integer", "string"], "minimum": 1 },
        "learning_rate_multiplier": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "auth": {
      "type": "object",
      "properties": {
        "api_key": { "type": "string" },
        "api_key_env": { "type": "string" },
        "organization": { "type": "string" },
        "organization_env": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["action"]
}
