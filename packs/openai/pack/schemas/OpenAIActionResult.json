{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAI Action Result",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "job_id": { "type": "string" },
    "profile": { "type": "string" },
    "action": { "type": "string" },
    "model": { "type": "string" },
    "status_code": { "type": "integer" },
    "request_id": { "type": "string" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"]
    },
    "cost_estimate": { "type": "number", "minimum": 0 },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit_requests": { "type": "integer", "minimum": 0 },
        "remaining_requests": { "type": "integer", "minimum": 0 },
        "reset_requests": { "type": "string" },
        "limit_tokens": { "type": "integer", "minimum": 0 },
        "remaining_tokens": { "type": "integer", "minimum": 0 },
        "reset_tokens": { "type": "string" },
        "retry_after_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "stream": { "type": "boolean" },
    "result": {},
    "error": { "type": "string" }
  }
}
