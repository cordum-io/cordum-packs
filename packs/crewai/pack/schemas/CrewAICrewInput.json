{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrewAI Crew Input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "crew_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "goal": { "type": "string", "minLength": 1 },
              "backstory": { "type": "string" },
              "llm_config": {
                "type": "object",
                "properties": {
                  "provider": { "type": "string" },
                  "model": { "type": "string" },
                  "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
                  "base_url": { "type": "string", "format": "uri" },
                  "api_key_env": { "type": "string" },
                  "max_tokens": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": true
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "description": { "type": "string" },
                    "inputSchema": { "type": "object" }
                  },
                  "required": ["name"],
                  "additionalProperties": true
                }
              },
              "allow_delegation": { "type": "boolean" },
              "verbose": { "type": "boolean" }
            },
            "required": ["role", "goal"],
            "additionalProperties": false
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "expected_output": { "type": "string" },
              "agent_role": { "type": "string", "minLength": 1 },
              "tools": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "async_execution": { "type": "boolean" },
              "context": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["description", "agent_role"],
            "additionalProperties": false
          }
        },
        "process": {
          "type": "string",
          "enum": ["sequential", "hierarchical"]
        },
        "manager_llm_config": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "base_url": { "type": "string", "format": "uri" },
            "api_key_env": { "type": "string" },
            "max_tokens": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        }
      },
      "required": ["agents", "tasks"],
      "additionalProperties": false
    },
    "input": {},
    "tool_governance": { "type": "boolean", "default": true },
    "trace_id": { "type": "string" }
  },
  "required": ["crew_config"]
}
