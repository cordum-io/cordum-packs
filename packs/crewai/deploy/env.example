# Cordum CrewAI Pack — Environment Variables

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker Configuration ---
CORDUM_CREWAI_POOL=crewai
CORDUM_CREWAI_QUEUE=crewai
CORDUM_CREWAI_SUBJECTS=job.crewai.*
CORDUM_CREWAI_MAX_PARALLEL=0
CORDUM_CREWAI_TIMEOUT=300s
CORDUM_CREWAI_RESULT_TTL=0s

# --- Governance Callback ---
CORDUM_CREWAI_CALLBACK_PORT=0
CORDUM_CREWAI_CALLBACK_WAIT_TIMEOUT=2m
CORDUM_CREWAI_TOOL_TOPIC=job.crewai.toolcall

# --- Python Sidecar ---
CORDUM_CREWAI_SIDECAR_COMMAND=python
CORDUM_CREWAI_SIDECAR_ARGS=-m,cordum_crewai_sidecar
# Optional extra PYTHONPATH entries (the worker already appends sidecar + agent-adapters paths)
CORDUM_CREWAI_SIDECAR_PYTHONPATH=

# --- CrewAI Runtime Tuning ---
CORDUM_CREWAI_MAX_RPM=0

# --- LLM API Keys (referenced by llm_config.api_key_env) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
