# Cordum Mistral Pack — Environment Variables

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Mistral API ---
MISTRAL_API_KEY=

# --- Worker Configuration ---
CORDUM_MISTRAL_POOL=mistral
CORDUM_MISTRAL_SUBJECTS=job.mistral.*
CORDUM_MISTRAL_MAX_PARALLEL=0
CORDUM_MISTRAL_REQUEST_TIMEOUT=120s
CORDUM_MISTRAL_RESULT_TTL=0s

# --- Mistral Settings ---
CORDUM_MISTRAL_BASE_URL=https://api.mistral.ai
CORDUM_MISTRAL_ALLOWED_MODELS=
CORDUM_MISTRAL_DENIED_MODELS=
CORDUM_MISTRAL_MAX_TOKENS_LIMIT=128000
CORDUM_MISTRAL_SAFE_PROMPT=false
