# Cordum n8n Pack — Environment Variables

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker Configuration ---
CORDUM_N8N_POOL=n8n
CORDUM_N8N_QUEUE=n8n
CORDUM_N8N_SUBJECTS=job.n8n.*
CORDUM_N8N_MAX_PARALLEL=0
CORDUM_N8N_REQUEST_TIMEOUT=120s
CORDUM_N8N_RESULT_TTL=0s
CORDUM_N8N_EXECUTION_POLL_INTERVAL=2s
CORDUM_N8N_EXECUTION_WAIT_TIMEOUT=5m

# --- Default n8n API Target ---
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# --- Workflow Restrictions (optional, comma-separated globs) ---
CORDUM_N8N_ALLOWED_WORKFLOWS=
CORDUM_N8N_DENIED_WORKFLOWS=

# --- Webhook Bridge ---
CORDUM_N8N_WEBHOOK_ENABLED=false
CORDUM_N8N_WEBHOOK_LISTEN=:9100
CORDUM_N8N_WEBHOOK_SECRET=
# JSON object mapping inbound webhook paths to Cordum workflow IDs.
# Example: {"/hooks/inbound":"cordum-workflow-id"}
CORDUM_N8N_WEBHOOK_WORKFLOW_MAP=

# --- Profile Selection ---
CORDUM_N8N_DEFAULT_PROFILE=default

# --- Multi-Profile (optional, JSON array) ---
# CORDUM_N8N_PROFILES=[{"name":"prod","base_url":"https://n8n.example.com","api_key_env":"PROD_N8N_API_KEY","allowed_workflows":["billing-*","crm-*"],"denied_workflows":["danger-*" ]},{"name":"staging","base_url":"https://n8n-staging.example.com","api_key_env":"STAGING_N8N_API_KEY"}]
