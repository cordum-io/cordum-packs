{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bedrock Invoke Model Input",
  "type": "object",
  "properties": {
    "model_id": { "type": "string", "description": "Model ID (e.g., anthropic.claude-v2, meta.llama3-8b-instruct-v1:0)." },
    "body": { "type": "object", "description": "Model-specific request body." },
    "accept": { "type": "string", "default": "application/json" },
    "content_type": { "type": "string", "default": "application/json" }
  },
  "required": ["model_id", "body"]
}
