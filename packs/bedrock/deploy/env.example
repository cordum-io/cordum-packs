# Cordum AWS Bedrock Pack — Environment Variables

CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- AWS Credentials ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Worker ---
CORDUM_BEDROCK_POOL=bedrock
CORDUM_BEDROCK_SUBJECTS=job.bedrock.*
CORDUM_BEDROCK_MAX_PARALLEL=0
CORDUM_BEDROCK_REQUEST_TIMEOUT=120s

# --- Model Restrictions ---
CORDUM_BEDROCK_ALLOWED_MODELS=
CORDUM_BEDROCK_DENIED_MODELS=
CORDUM_BEDROCK_MAX_TOKENS=128000
