{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS SNS Publish Input",
  "description": "Input schema for SNS Publish.",
  "type": "object",
  "properties": {
    "topic_arn": {
      "type": "string",
      "description": "SNS topic ARN."
    },
    "message": {
      "type": "string",
      "description": "Message body."
    },
    "subject": {
      "type": "string",
      "description": "Message subject (email endpoints only)."
    },
    "message_structure": {
      "type": "string",
      "description": "Set to 'json' for per-protocol messages.",
      "enum": ["json"]
    },
    "message_attributes": {
      "type": "object",
      "description": "Message attributes."
    }
  },
  "required": ["topic_arn", "message"]
}
