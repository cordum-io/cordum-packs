{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS Secrets Manager Get Secret Value Input",
  "description": "Input schema for Secrets Manager GetSecretValue.",
  "type": "object",
  "properties": {
    "secret_id": {
      "type": "string",
      "description": "Secret name or ARN."
    },
    "version_id": {
      "type": "string",
      "description": "Secret version ID."
    },
    "version_stage": {
      "type": "string",
      "description": "Secret version stage (e.g., AWSCURRENT, AWSPREVIOUS).",
      "default": "AWSCURRENT"
    }
  },
  "required": ["secret_id"]
}
