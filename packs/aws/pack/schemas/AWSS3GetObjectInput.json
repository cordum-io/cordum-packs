{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS S3 Get Object Input",
  "description": "Input schema for S3 GetObject.",
  "type": "object",
  "properties": {
    "bucket": {
      "type": "string",
      "description": "S3 bucket name."
    },
    "key": {
      "type": "string",
      "description": "Object key."
    },
    "version_id": {
      "type": "string",
      "description": "Object version ID."
    }
  },
  "required": ["bucket", "key"]
}
