# Cordum AWS Pack — Environment Variables

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker Configuration ---
CORDUM_AWS_POOL=aws
CORDUM_AWS_QUEUE=aws
CORDUM_AWS_SUBJECTS=job.aws.*
CORDUM_AWS_MAX_PARALLEL=0
CORDUM_AWS_REQUEST_TIMEOUT=60s
CORDUM_AWS_RESULT_TTL=0s

# --- AWS Credentials ---
# Standard AWS credential chain: env vars → shared credentials → EC2 metadata
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Cross-Account Access (optional) ---
CORDUM_AWS_ROLE_ARN=
CORDUM_AWS_EXTERNAL_ID=

# --- Action/Resource Restrictions (optional, comma-separated) ---
# Glob patterns: s3.*, lambda.invoke, ec2.*
CORDUM_AWS_ALLOW_ACTIONS=
CORDUM_AWS_DENY_ACTIONS=
# ARN glob patterns: arn:aws:s3:::prod-*, arn:aws:lambda:us-east-1:*
CORDUM_AWS_ALLOWED_RESOURCES=
CORDUM_AWS_DENIED_RESOURCES=

# --- Inline Auth (advanced) ---
CORDUM_AWS_ALLOW_INLINE_AUTH=false
CORDUM_AWS_ALLOW_INLINE_SECRETS=false
CORDUM_AWS_DEFAULT_PROFILE=default

# --- Multi-Profile (optional, JSON array) ---
# CORDUM_AWS_PROFILES=[{"name":"prod","region":"us-east-1","role_arn":"arn:aws:iam::123456789012:role/cordum-prod","allow_actions":["s3.*","lambda.*"]},{"name":"staging","region":"us-west-2","access_key_id_env":"STAGING_AWS_KEY","secret_access_key_env":"STAGING_AWS_SECRET"}]
