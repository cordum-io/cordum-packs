{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoGen Action Result",
  "type": "object",
  "properties": {
    "job_id": { "type": "string" },
    "profile": { "type": "string" },
    "action": { "type": "string" },
    "duration_ms": { "type": "number" },
    "summary": { "type": "string", "description": "Final summary or output." },
    "chat_history": {
      "type": "array",
      "description": "Full conversation history.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "code_output": {
      "type": "object",
      "description": "Code execution output (code action).",
      "properties": {
        "exit_code": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      }
    },
    "tool_calls": { "type": "array" },
    "agent_transitions": { "type": "integer", "description": "Number of agent transitions in group chat." },
    "result": { "type": ["object", "array", "null"] },
    "error": { "type": "string" }
  }
}
