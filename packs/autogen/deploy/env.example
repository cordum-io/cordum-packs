# Cordum AutoGen Pack — Environment Variables

CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker ---
CORDUM_AUTOGEN_POOL=autogen
CORDUM_AUTOGEN_SUBJECTS=job.autogen.*
CORDUM_AUTOGEN_MAX_PARALLEL=0
CORDUM_AUTOGEN_REQUEST_TIMEOUT=300s

# --- Sidecar ---
CORDUM_AUTOGEN_PYTHON_CMD=python
CORDUM_AUTOGEN_SIDECAR_MODULE=cordum_autogen_sidecar
CORDUM_AUTOGEN_SIDECAR_PORT=0

# --- Governance ---
CORDUM_AUTOGEN_TOOL_GOVERNANCE=true
CORDUM_AUTOGEN_TOOLCALL_TOPIC=job.autogen.toolcall

# --- Code Execution ---
# docker (recommended), disabled (no code exec)
CORDUM_AUTOGEN_CODE_EXECUTION=docker
CORDUM_AUTOGEN_DOCKER_IMAGE=python:3.12-slim
CORDUM_AUTOGEN_CODE_TIMEOUT=30
CORDUM_AUTOGEN_MAX_ROUNDS=20

# --- LLM API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
