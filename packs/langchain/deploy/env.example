# Cordum LangChain Pack — Environment Variables
# Copy to .env and fill in required values.

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker Configuration ---
CORDUM_LANGCHAIN_POOL=langchain
CORDUM_LANGCHAIN_QUEUE=langchain
CORDUM_LANGCHAIN_SUBJECTS=job.langchain.*
CORDUM_LANGCHAIN_MAX_PARALLEL=0
CORDUM_LANGCHAIN_REQUEST_TIMEOUT=300s
CORDUM_LANGCHAIN_RESULT_TTL=0s

# --- Sidecar Configuration ---
CORDUM_LANGCHAIN_PYTHON_CMD=python
CORDUM_LANGCHAIN_SIDECAR_MODULE=cordum_langchain_sidecar
CORDUM_LANGCHAIN_SIDECAR_PORT=0

# --- Governance ---
# When true, every agent tool call routes through CAP Safety Kernel.
CORDUM_LANGCHAIN_TOOL_GOVERNANCE=true
CORDUM_LANGCHAIN_TOOLCALL_TOPIC=job.langchain.toolcall
CORDUM_LANGCHAIN_CAPABILITY_PREFIX=langchain

# --- LLM API Keys (passed through to Python sidecar) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
