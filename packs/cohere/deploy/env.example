# Cordum Cohere Pack — Environment Variables

CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Cohere API ---
COHERE_API_KEY=

# --- Worker ---
CORDUM_COHERE_POOL=cohere
CORDUM_COHERE_SUBJECTS=job.cohere.*
CORDUM_COHERE_MAX_PARALLEL=0
CORDUM_COHERE_REQUEST_TIMEOUT=120s
CORDUM_COHERE_RESULT_TTL=0s
CORDUM_COHERE_BASE_URL=https://api.cohere.com
CORDUM_COHERE_ALLOWED_MODELS=
CORDUM_COHERE_DENIED_MODELS=
