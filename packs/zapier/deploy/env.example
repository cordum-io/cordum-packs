# Core Cordum connectivity
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# Worker runtime
CORDUM_ZAPIER_POOL=zapier
CORDUM_ZAPIER_QUEUE=zapier
CORDUM_ZAPIER_SUBJECTS=job.zapier.*
CORDUM_ZAPIER_MAX_PARALLEL=8
CORDUM_ZAPIER_REQUEST_TIMEOUT=120s
CORDUM_ZAPIER_RESULT_TTL=24h

# Zapier AI Actions / legacy NLA
# Current Zapier docs point API-key based AI Actions traffic at https://actions.zapier.com/api/v2.
# Override this if you must target a legacy/private NLA deployment.
ZAPIER_NLA_BASE_URL=https://actions.zapier.com/api/v2
ZAPIER_NLA_API_KEY=

# Webhook aliasing
# JSON map of alias -> full Zapier catch hook URL. Aliases are what Cordum workflows reference.
# Example: {"orders":"https://hooks.zapier.com/hooks/catch/123456/orders","alerts":"https://hooks.zapier.com/hooks/catch/123456/alerts"}
CORDUM_ZAPIER_WEBHOOK_URLS={}

# Optional guardrails
# If action allow/deny lists are configured, nla.execute / nla.preview calls must provide action_id.
CORDUM_ZAPIER_ALLOWED_ACTIONS=
CORDUM_ZAPIER_DENIED_ACTIONS=
CORDUM_ZAPIER_ALLOWED_WEBHOOKS=
CORDUM_ZAPIER_DENIED_WEBHOOKS=
