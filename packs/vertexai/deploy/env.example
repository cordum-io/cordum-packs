# Cordum Vertex AI Pack — Environment Variables

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker Configuration ---
CORDUM_VERTEXAI_POOL=vertexai
CORDUM_VERTEXAI_QUEUE=vertexai
CORDUM_VERTEXAI_SUBJECTS=job.vertexai.*
CORDUM_VERTEXAI_MAX_PARALLEL=0
CORDUM_VERTEXAI_REQUEST_TIMEOUT=120s
CORDUM_VERTEXAI_RESULT_TTL=0s
CORDUM_VERTEXAI_USER_AGENT=cordum-vertexai-worker/0.1.0

# --- Default Vertex AI Target ---
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
VERTEX_LOCATION=us-central1

# --- Authentication ---
# Application Default Credentials are used automatically when no explicit
# credentials file is configured.
GOOGLE_APPLICATION_CREDENTIALS=
CORDUM_VERTEXAI_IMPERSONATE_SERVICE_ACCOUNT=

# --- Model Restrictions (optional, comma-separated globs) ---
CORDUM_VERTEXAI_ALLOWED_MODELS=
CORDUM_VERTEXAI_DENIED_MODELS=
CORDUM_VERTEXAI_MAX_TOKENS_PER_REQUEST=32768

# --- Profile Selection ---
CORDUM_VERTEXAI_DEFAULT_PROFILE=default

# --- Multi-Profile (optional, JSON array) ---
# CORDUM_VERTEXAI_PROFILES=[{"name":"prod","project_id":"prod-project","location":"us-central1","credentials_file_env":"PROD_GOOGLE_APPLICATION_CREDENTIALS","impersonate_sa":"vertex-prod@prod-project.iam.gserviceaccount.com","allowed_models":["gemini-*","textembedding-gecko*"],"max_tokens_per_request":8192},{"name":"staging","project_id":"staging-project","location":"us-east4","allowed_models":["gemini-2.5-flash"]}]
