{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vertex AI Predict Input",
  "description": "Input schema for Vertex AI online prediction against a deployed endpoint.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "endpoint_id": {
      "type": "string",
      "description": "Endpoint ID or fully-qualified endpoint resource name."
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "object" },
          { "type": "array" },
          { "type": "string" },
          { "type": "number" },
          { "type": "integer" },
          { "type": "boolean" }
        ]
      }
    },
    "parameters": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ],
      "description": "Optional model-specific prediction parameters."
    },
    "deployed_model_id": {
      "type": "string",
      "description": "Optional deployed model ID hint for raw prediction routes."
    }
  },
  "required": [
    "endpoint_id",
    "instances"
  ],
  "additionalProperties": false
}
