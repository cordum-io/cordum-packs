{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anthropic Messages Input",
  "description": "Input schema for Anthropic Messages API requests.",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "description": "Model identifier.",
      "enum": [
        "claude-opus-4-6",
        "claude-sonnet-4-6",
        "claude-haiku-4-5"
      ]
    },
    "max_tokens": {
      "type": "integer",
      "description": "Maximum number of tokens to generate. Required by the Anthropic API.",
      "minimum": 1
    },
    "messages": {
      "type": "array",
      "description": "Conversation messages.",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant"]
          },
          "content": {
            "description": "Message content — string or array of content blocks.",
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "description": "Text content block.",
                      "properties": {
                        "type": { "type": "string", "const": "text" },
                        "text": { "type": "string" }
                      },
                      "required": ["type", "text"]
                    },
                    {
                      "type": "object",
                      "description": "Image content block (vision).",
                      "properties": {
                        "type": { "type": "string", "const": "image" },
                        "source": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": ["base64", "url"]
                            },
                            "media_type": {
                              "type": "string",
                              "enum": ["image/jpeg", "image/png", "image/gif", "image/webp"]
                            },
                            "data": {
                              "type": "string",
                              "description": "Base64-encoded image data (when type=base64)."
                            },
                            "url": {
                              "type": "string",
                              "description": "Image URL (when type=url)."
                            }
                          },
                          "required": ["type", "media_type"]
                        }
                      },
                      "required": ["type", "source"]
                    },
                    {
                      "type": "object",
                      "description": "Tool use content block (from assistant).",
                      "properties": {
                        "type": { "type": "string", "const": "tool_use" },
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "input": { "type": "object" }
                      },
                      "required": ["type", "id", "name", "input"]
                    },
                    {
                      "type": "object",
                      "description": "Tool result content block (from user).",
                      "properties": {
                        "type": { "type": "string", "const": "tool_result" },
                        "tool_use_id": { "type": "string" },
                        "content": {
                          "description": "Tool result content — string or array of content blocks.",
                          "oneOf": [
                            { "type": "string" },
                            { "type": "array", "items": { "type": "object" } }
                          ]
                        },
                        "is_error": { "type": "boolean" }
                      },
                      "required": ["type", "tool_use_id"]
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": ["role", "content"]
      }
    },
    "system": {
      "description": "System prompt — string or array of content blocks.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "text" },
              "text": { "type": "string" }
            },
            "required": ["type", "text"]
          }
        }
      ]
    },
    "temperature": {
      "type": "number",
      "description": "Sampling temperature (0.0 to 1.0).",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "top_p": {
      "type": "number",
      "description": "Nucleus sampling parameter.",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "top_k": {
      "type": "integer",
      "description": "Top-K sampling parameter.",
      "minimum": 1
    },
    "stop_sequences": {
      "type": "array",
      "description": "Custom stop sequences.",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "description": "Tool definitions for tool use.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tool name (a-z, 0-9, underscores)."
          },
          "description": {
            "type": "string",
            "description": "Detailed description of what the tool does."
          },
          "input_schema": {
            "type": "object",
            "description": "JSON Schema for tool input parameters."
          }
        },
        "required": ["name", "description", "input_schema"]
      }
    },
    "tool_choice": {
      "description": "Tool selection strategy.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["auto", "any", "none"] }
          },
          "required": ["type"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "tool" },
            "name": { "type": "string" }
          },
          "required": ["type", "name"]
        }
      ]
    },
    "thinking": {
      "type": "object",
      "description": "Extended thinking configuration.",
      "properties": {
        "type": {
          "type": "string",
          "const": "enabled"
        },
        "budget_tokens": {
          "type": "integer",
          "description": "Maximum tokens for thinking.",
          "minimum": 1024
        }
      },
      "required": ["type", "budget_tokens"]
    },
    "metadata": {
      "type": "object",
      "description": "Request metadata.",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "External user identifier for abuse detection."
        }
      }
    },
    "stream": {
      "type": "boolean",
      "description": "Whether to stream the response (set automatically by topic)."
    }
  },
  "required": ["model", "max_tokens", "messages"]
}
