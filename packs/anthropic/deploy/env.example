# Cordum Anthropic Pack — Environment Variables
# Copy to .env and fill in required values.

# --- Cordum Infrastructure ---
CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Anthropic API ---
# Required: Anthropic API key (used as x-api-key header)
ANTHROPIC_API_KEY=

# --- Worker Configuration ---
CORDUM_ANTHROPIC_POOL=anthropic
CORDUM_ANTHROPIC_QUEUE=anthropic
CORDUM_ANTHROPIC_SUBJECTS=job.anthropic.*
CORDUM_ANTHROPIC_MAX_PARALLEL=0
CORDUM_ANTHROPIC_REQUEST_TIMEOUT=120s
CORDUM_ANTHROPIC_RESULT_TTL=0s

# --- Anthropic API Settings ---
CORDUM_ANTHROPIC_BASE_URL=https://api.anthropic.com
CORDUM_ANTHROPIC_API_VERSION=2023-06-01
CORDUM_ANTHROPIC_USER_AGENT=cordum-anthropic-worker/0.1.0

# --- Model Restrictions ---
# Comma-separated. Empty = all models allowed.
CORDUM_ANTHROPIC_ALLOWED_MODELS=
CORDUM_ANTHROPIC_DENIED_MODELS=
CORDUM_ANTHROPIC_MAX_TOKENS_LIMIT=128000

# --- Tool Governance ---
# When true, tool_use blocks are routed through CAP Safety Kernel.
CORDUM_ANTHROPIC_TOOL_GOVERNANCE=true

# --- Extended Thinking ---
CORDUM_ANTHROPIC_THINKING_ENABLED=false
CORDUM_ANTHROPIC_THINKING_MAX_BUDGET=65536

# --- Inline Auth (advanced) ---
CORDUM_ANTHROPIC_ALLOW_INLINE_AUTH=false
CORDUM_ANTHROPIC_ALLOW_INLINE_SECRETS=false
CORDUM_ANTHROPIC_DEFAULT_PROFILE=default

# --- Multi-Profile (optional, JSON array) ---
# CORDUM_ANTHROPIC_PROFILES=[{"name":"prod","api_key_env":"ANTHROPIC_PROD_KEY","allowed_models":["claude-sonnet-4-6"],"thinking_enabled":true}]
