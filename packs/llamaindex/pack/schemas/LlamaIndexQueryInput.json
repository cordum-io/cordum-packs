{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LlamaIndex Query Input",
  "type": "object",
  "properties": {
    "index_config": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["vector", "list", "keyword", "tree"] },
        "store_config": {
          "type": "object",
          "properties": {
            "backend": { "type": "string", "enum": ["chroma", "pinecone", "qdrant", "weaviate", "local"] },
            "collection_name": { "type": "string" },
            "persist_dir": { "type": "string" },
            "connection_string_env": { "type": "string" }
          }
        }
      }
    },
    "query": { "type": "string", "description": "Query string." },
    "llm_config": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["openai", "anthropic", "mistral", "local"] },
        "model": { "type": "string" },
        "temperature": { "type": "number" },
        "api_key_env": { "type": "string" }
      }
    },
    "similarity_top_k": { "type": "integer", "minimum": 1, "default": 5 },
    "response_mode": { "type": "string", "enum": ["refine", "compact", "tree_summarize", "simple_summarize", "no_text", "accumulate"] }
  },
  "required": ["query"]
}
