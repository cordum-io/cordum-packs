{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LlamaIndex Retrieve Input",
  "type": "object",
  "properties": {
    "index_config": { "type": "object" },
    "query": { "type": "string" },
    "similarity_top_k": { "type": "integer", "minimum": 1, "default": 5 },
    "filters": {
      "type": "object",
      "description": "Metadata filters for retrieval."
    }
  },
  "required": ["query"]
}
