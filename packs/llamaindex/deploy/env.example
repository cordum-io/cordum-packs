# Cordum LlamaIndex Pack — Environment Variables

CORDUM_GATEWAY_URL=http://localhost:8081
CORDUM_API_KEY=
CORDUM_TENANT_ID=default
CORDUM_NATS_URL=nats://localhost:4222
CORDUM_REDIS_URL=redis://localhost:6379

# --- Worker ---
CORDUM_LLAMAINDEX_POOL=llamaindex
CORDUM_LLAMAINDEX_SUBJECTS=job.llamaindex.*
CORDUM_LLAMAINDEX_MAX_PARALLEL=0
CORDUM_LLAMAINDEX_REQUEST_TIMEOUT=300s
CORDUM_LLAMAINDEX_RESULT_TTL=0s

# --- Sidecar ---
CORDUM_LLAMAINDEX_PYTHON_CMD=python
CORDUM_LLAMAINDEX_SIDECAR_MODULE=cordum_llamaindex_sidecar
CORDUM_LLAMAINDEX_SIDECAR_PORT=0

# --- Storage ---
CORDUM_LLAMAINDEX_STORAGE_DIR=./llamaindex_storage
CORDUM_LLAMAINDEX_DEFAULT_BACKEND=chroma

# --- LLM API Keys (passed to sidecar) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
